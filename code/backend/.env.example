APP_NAME="Gestor Job"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Produção: URL pública da SPA (CORS). Obrigatório se APP_ENV=production.
FRONTEND_URL=http://localhost:5173

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=gestor_job
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost

SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Anexos e dumps vão para o bucket S3 `gestorjob` (pastas anexos/ e postgres/).
# Testes usam ANEXOS_DISK=local. No app: s3.
ANEXOS_DISK=s3
AWS_BUCKET=gestorjob
AWS_DEFAULT_REGION=us-east-1
QUEUE_CONNECTION=database

CACHE_STORE=file

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@gestorjob.local"
MAIL_FROM_NAME="${APP_NAME}"

# Produção (SES + S3) — ver docs/SES-CLOUDFLARE.md e docs/DEPLOY.md
# MAIL_MAILER=ses
# MAIL_FROM_ADDRESS="noreply@gestorjob.com.br"
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
